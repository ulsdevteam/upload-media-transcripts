def get_mimetype(infile):
    mime_type, encoding = mimetypes.guess_type(infile)
    return mime_type or 'application/octet_stream'

def peertube_add_caption(
    access_token: str,
    video_id: str,
    language: str,
    caption_file_path: str
) -> dict:
    """
    Upload a caption file to a PeerTube video.

    Args:
        video_id (str): UUID or short UUID of the video
        language (str): Language code for the caption (e.g., 'en', 'fr')
        caption_file_path (str): Path to the caption file (.srt or .vtt)
        access_token (str): Bearer token for authentication

    Returns:
        dict: Response from the API with status

    Raises:
        FileNotFoundError: If the caption file doesn't exist
        ValueError: If the file format is invalid
        requests.exceptions.RequestException: If the API request fails
    """

    # Validate caption file
    if not os.path.exists(caption_file_path):
        raise FileNotFoundError(f"Caption file not found: {caption_file_path}")

    if not caption_file_path.lower().endswith(('.srt', '.vtt')):
        raise ValueError("Caption file must be .srt or .vtt format")

    # Prepare API endpoint
    add_caption_endpoint = f"{peertube_instance.rstrip('/')}/api/v1/videos/{video_id}/captions/{language}"
    logger.info(f"Add Caption Endpoint: {add_caption_endpoint}")

    # Prepare headers
    headers = {
        "Authorization": f"Bearer {access_token}"
    }

    # For testing.
    logger.info(f"Adding caption {caption_file_path} to Video {video_id} with language {language}")
    print(f"Adding caption {caption_file_path}")
    print(f"To Video {video_id} with language {language}")
    logger.info(f"Caption file path: {caption_file_path}")
    logger.info(f"Caption file mime type: {get_mimetype(caption_file_path)}")
    

    if dry_run:
        logger.info(f"Dry run enabled - skipping actual caption upload.")
        return {
            "status": 200,
            "message": "Dry run - caption upload skipped",
            "data": None
        }
    else:
        logger.info(f"Dry run not enabled - proceeding with caption upload.")
        
        # Prepare file for upload
        with open(caption_file_path, 'rb') as caption_file:
            caption_files = {
                'captionfile': (
                    os.path.basename(caption_file_path),
                    caption_file,
                    get_mimetype(caption_file_path)
                )
            }
        logger.info(f"Prepared caption file for upload: {caption_files['captionfile'][0]}, MIME type: {caption_files['captionfile'][2]}")

        # Upload caption
        try:
            # Make PUT request to upload caption
            response = requests.put(add_caption_endpoint, headers=headers, files=caption_files, verify=False)

            # Handle HTTP 204 (No Content) for successful upload
            if response.status_code == 204:
                logger.info("Caption uploaded successfully, received 204 No Content response.")
                return {
                    "status": 204,
                    "message": "Caption uploaded successfully",
                    "data": None
                }

            # Try to parse JSON response for other status codes
            try:
                response_data = response.json()
            except ValueError:
                response_data = {
                    "raw_response": response.text or "Empty response"
                }
                logger.error(f"Failed to parse response as JSON. Raw response: {response_data['raw_response']}")
                print(f"Failed to parse response as JSON. Raw response: {response_data['raw_response']}")

            # Check response status
            try:
                response.raise_for_status()
            except requests.exceptions.HTTPError as e:
                try: 
                    error_details = response.json()
                except ValueError:
                    error_details = {
                        "raw_response": response.text or "Empty response"
                    }
                    logger.error(f"Failed to parse error response as JSON. Raw response: {error_details['raw_response']}")
                    print(f"Failed to parse error response as JSON. Raw response: {error_details['raw_response']}")
                logger.error(f"HTTP error occurred: {str(e)} | Details: {error_details}")
                print(f"HTTP error occurred: {str(e)} | Details: {error_details}")
                return {
                    "status": response.status_code,
                    "error": str(e),
                    "details": error_details
                }

            # Return response data for successful upload (non-204)
            return {
                "status": response.status_code,
                "message": f"Caption uploaded successfully received non-204 response: {response.status_code}",
                "data": response_data
            }

        except requests.exceptions.RequestException as e:
            logger.error(f"API request failed: {str(e)}")
            print(f"API request failed: {str(e)}")
            return {
                "status": None,
                "error": f"API request failed: {str(e)}",
                "details": None
            }

def process_row(df: pd.DataFrame, row) -> pd.DataFrame:
    # Required Vars for all media objects.
    video_id    = row['id']
    video_title = row['title']
    video_file  = row['file']

    # Optional Vars for optional components.
    video_transcript = ''
    video_transcript_lang = ''
    video_url = ''

    # Determine the required components.
    transcript = False
    if 'transcript' in df.columns:
        if not row['transcript'] == None:
            transcript = True
            video_transcript = row['transcript']
            logger.info(f"Video transcript column found.")

    peertube_media_shortUUID = ''
    if 'field_media_oembed_video' in df.columns:
        if not row['field_media_oembed_video'] == "":
            video_url = row['field_media_oembed_video']
            parsed = urllib3.util.parse_url(video_url)
            path_parts = parsed.path.strip('/').split('/')
            logger.info(f"Parsed field_media_oembed_video: {path_parts}")
            peertube_media_shortUUID = path_parts[1]
            logger.info(f"Short UUID = {peertube_media_shortUUID}")

    # Get Transcript Language and validate it against the PeerTube API languages list if a transcript exists.
    if transcript:
        if 'transcript_language' in df.columns:
            if not row['transcript_language'] == "":
                video_transcript_lang = find_language_code(row['transcript_language'], peertube_instance)
                logger.info(f"Transcript language code: {video_transcript_lang}")
            else:
                video_transcript_lang = "zxx"
                logger.info(f"Transcript language code: {video_transcript_lang}")
        else:
            # Set vidoe_transcript_lang to Default of 'en'
            logger.info(f"Transcript language code: 'zxx' (default)")
            video_transcript_lang = "zxx"
                    
    # Add the Transcript to the Media Object if the transcript exists and if the upload was successful.
    if transcript:
        # Add a transcript to the previously uploaded media.
        logger.info(f"{video_id} Transcript/Caption upload - file: {video_transcript}")
        logger.info(f"PeerTube Video:{peertube_media_shortUUID}")
        logger.info(f"Transcript Language:{video_transcript_lang}")
        # Upload transcript
        peertube_caption_result = peertube_add_caption(access_token,peertube_media_shortUUID,video_transcript_lang,video_transcript)
        
        # Get the upload status and log the result.
        caption_status = peertube_caption_result["status"]
        if caption_status == 200:
            logger.info(f"{video_id} Transcription/Caption upload - 200 Success.")
        elif caption_status == 204:
            logger.info(f"{video_id} Transcription/Caption upload - 204 Successful Upload of Caption.")
        elif caption_status == 400:
            logger.warning(f"{video_id} Transcription/Caption upload - 400 Error - {peertube_caption_result["error"]}.")
        elif caption_status == 404:
            logger.warning(f"{video_id} Transcription/Caption upload - 404 Video or Language not found.")
        else:
            logger.error(f"{video_id} Transcription/Caption upload - Error: {caption_status}.")
    else:
        logger.info(f"Transcript/Caption was not added to Media {video_id}")

    return df


def process_sheet(sheet_id: str, sheet_name: str, credentials_file):
    logger.info(f"process_sheet - Processing Sheet: {sheet_id},{sheet_name}")

    # Read the Sheet
    df = read_google_sheet(sheet_id, sheet_name, credentials_file)

    # Check for Required columns
    required_columns = ['id','title','file','field_media_oembed_video']
    optional_columns = ['description','language','transcript','transcript_language']
    
    row_count = 1
    if all(col in df.columns for col in required_columns):
        logger.info(f"Begin Processing Sheet: {sheet_id},{sheet_name}.")
                
        # Process each row in the sheet
        for index,row in df.iterrows():
            # Get Row information.
            video_id    = row['id']

            # Proces the row
            logger.info(f"-----------------------------------------------------")
            print(f"-----------------------------------------------------")
            logger.info(f"Processing Row {row_count} - Video ID: {video_id}")
            print(f"Processing Row {row_count} - Video ID: {video_id}")
            #logger.info(f"Processing: {video_id}")
            #print(f"Processing: {video_id}")
            df = process_row(df, row)
            row_count = row_count + 1
        logger.info(f"Finished processing sheet: {sheet_id}, {sheet_name}. Processed {row_count} rows.")
        print(f"-----------------------------------------------------")
        print(f"Finished processing sheet: {sheet_id}, {sheet_name}. ")
        print(f"Processed {row_count} rows.")
    else:
        logger.warning(f"One or more required columns are missing from the sheet.")
        print(f"One or more required columns are missing from the sheet.")
        print(f"Required columns are: {required_columns}.")
        logger.warning(f"Existing Columns are: {df.columns}.")
        print(f"Existing columns are: {df.columns}.")
        exit()

    return row_count

